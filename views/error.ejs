<% layout("/layouts/boilerplate") %>

<div class="error-page-container">
  <div class="error-card">
    <div class="error-icon-box">
      <i class="fa-solid fa-triangle-exclamation"></i>
    </div>
    <h2 class="fw-bold text-dark mb-2">Oops! Something went wrong</h2>
    <p class="text-muted mb-4 fs-6">
      <%= message || "We couldn't find the page or resource you were looking for." %>
    </p>
    <div class="d-flex justify-content-center gap-3">
      <a href="/listings" class="btn btn-primary-gradient px-4 py-2" style="width: auto;">
        <i class="fa-solid fa-compass me-1"></i> Explore Listings
      </a>
      <a href="/" class="btn btn-outline-secondary px-4 py-2 rounded-3">
        Back to Home
      </a>
    </div>
  </div>
</div>
