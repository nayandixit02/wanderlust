<% layout("/layouts/boilerplate") %>

<div class="container show-header">
  <!-- Breadcrumb -->
  <div class="show-breadcrumbs">
    <a href="/listings"><i class="fa-solid fa-house me-1"></i> Listings</a>
    <i class="fa-solid fa-chevron-right fs-xs"></i>
    <span class="text-truncate" style="max-width: 300px;"><%= listing.title %></span>
  </div>

  <!-- Title & Action Bar -->
  <div class="show-title-row">
    <div>
      <h1 class="show-listing-title"><%= listing.title %></h1>
      <div class="d-flex align-items-center gap-3 mt-2 text-muted">
        <span><i class="fa-solid fa-star text-warning"></i> <b><%= listing.reviews && listing.reviews.length ? "4.95" : "New" %></b> · <a href="#reviewsSection" class="text-decoration-underline text-dark"><%= listing.reviews ? listing.reviews.length : 0 %> reviews</a></span>
        <span>·</span>
        <span><i class="fa-solid fa-location-dot text-danger"></i> <%= listing.location %>, <%= listing.country %></span>
      </div>
    </div>

    <div class="show-header-actions">
      <button class="btn-icon-action" onclick="navigator.clipboard.writeText(window.location.href); alert('Listing link copied to clipboard!');">
        <i class="fa-solid fa-share-nodes"></i> Share
      </button>
      <button class="btn-icon-action card-heart-btn-show" onclick="this.classList.toggle('text-danger');">
        <i class="fa-regular fa-heart"></i> Save
      </button>
    </div>
  </div>
</div>

<!-- Hero Image Gallery -->
<div class="show-hero-media">
  <img
    src="<%= listing.image.url %>"
    alt="<%= listing.title %>"
  />
</div>

<!-- Main Content Grid -->
<div class="row g-5">
  <!-- Left Column: Details, Amenities, Host & Reviews -->
  <div class="col-lg-8">
    <!-- Host Profile Card -->
    <div class="host-profile-card">
      <div class="host-details">
        <div class="host-avatar">
          <%= listing.owner && listing.owner.username ? listing.owner.username.charAt(0).toUpperCase() : 'H' %>
        </div>
        <div>
          <h5 class="host-name">Hosted by <%= listing.owner ? listing.owner.username : 'Superhost' %></h5>
          <p class="host-subtext">Verified Host · Fast Responder · 100% Identity Verified</p>
        </div>
      </div>
      <span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill fw-bold">
        <i class="fa-solid fa-medal me-1"></i> Superhost
      </span>
    </div>

    <!-- Description -->
    <div class="description-card">
      <h4 class="section-subheading">About this space</h4>
      <p class="description-text"><%= listing.description %></p>
    </div>

    <!-- Amenities -->
    <div class="description-card">
      <h4 class="section-subheading">What this place offers</h4>
      <div class="amenities-grid">
        <div class="amenity-item">
          <i class="fa-solid fa-wifi"></i>
          <span>Fast High-speed Wi-Fi (100+ Mbps)</span>
        </div>
        <div class="amenity-item">
          <i class="fa-solid fa-square-parking"></i>
          <span>Free parking on premises</span>
        </div>
        <div class="amenity-item">
          <i class="fa-solid fa-temperature-arrow-down"></i>
          <span>Air conditioning & heating</span>
        </div>
        <div class="amenity-item">
          <i class="fa-solid fa-kitchen-set"></i>
          <span>Fully equipped modern kitchen</span>
        </div>
        <div class="amenity-item">
          <i class="fa-solid fa-water-ladder"></i>
          <span>Swimming pool & patio</span>
        </div>
        <div class="amenity-item">
          <i class="fa-solid fa-tv"></i>
          <span>HDTV with Netflix & Prime</span>
        </div>
        <div class="amenity-item">
          <i class="fa-solid fa-briefcase"></i>
          <span>Dedicated ergonomic workspace</span>
        </div>
        <div class="amenity-item">
          <i class="fa-solid fa-shield-virus"></i>
          <span>Smoke alarm & first-aid kit</span>
        </div>
      </div>
    </div>

    <!-- Owner Controls (Edit/Delete) -->
    <% if(currUser && listing.owner && currUser._id.equals(listing.owner._id)) { %>
    <div class="owner-actions-row">
      <a href="/listings/<%= listing._id %>/edit" class="btn btn-owner-edit">
        <i class="fa-solid fa-pen-to-square me-1"></i> Edit Listing
      </a>
      <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline" onsubmit="return confirm('Are you sure you want to permanently delete this listing?');">
        <button class="btn btn-owner-delete" type="submit">
          <i class="fa-solid fa-trash-can me-1"></i> Delete Listing
        </button>
      </form>
    </div>
    <% } %>

    <!-- Reviews Section -->
    <div class="reviews-section" id="reviewsSection">
      <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
          <h3 class="section-title mb-1">
            <i class="fa-solid fa-star text-warning"></i> 
            <%= listing.reviews && listing.reviews.length ? "4.95" : "No reviews yet" %>
          </h3>
          <p class="text-muted mb-0"><%= listing.reviews ? listing.reviews.length : 0 %> verified guest reviews</p>
        </div>
      </div>

      <!-- Add Review Form (Only Logged In Users) -->
      <% if(currUser) { %>
      <div class="review-form-card">
        <h5 class="fw-bold mb-3"><i class="fa-solid fa-comment-dots text-danger me-2"></i>Leave a Review</h5>
        <form
          action="/listings/<%= listing._id %>/reviews"
          method="POST"
          novalidate
          class="needs-validation"
        >
          <div class="mb-3">
            <label class="form-label fw-semibold">Your Rating</label>
            <fieldset class="starability-slot">
              <input
                type="radio"
                id="no-rate"
                class="input-no-rate"
                name="review[rating]"
                value="1"
                checked
                aria-label="No rating."
              />
              <input type="radio" id="first-rate1" name="review[rating]" value="1" />
              <label for="first-rate1" title="Terrible">1 star</label>
              <input type="radio" id="first-rate2" name="review[rating]" value="2" />
              <label for="first-rate2" title="Not good">2 stars</label>
              <input type="radio" id="first-rate3" name="review[rating]" value="3" />
              <label for="first-rate3" title="Average">3 stars</label>
              <input type="radio" id="first-rate4" name="review[rating]" value="4" />
              <label for="first-rate4" title="Very good">4 stars</label>
              <input type="radio" id="first-rate5" name="review[rating]" value="5" />
              <label for="first-rate5" title="Amazing">5 stars</label>
            </fieldset>
          </div>

          <div class="mb-3">
            <label for="comment" class="form-label fw-semibold">Your Experience</label>
            <textarea
              name="review[comment]"
              id="comment"
              cols="30"
              rows="4"
              class="form-control form-control-custom"
              placeholder="Tell other travelers about your stay, hospitality, and local surroundings..."
              required
            ></textarea>
            <div class="invalid-feedback">Please write a comment for your review.</div>
          </div>

          <button class="btn btn-primary-gradient px-4 py-2" style="width: auto;" type="submit">
            <i class="fa-solid fa-paper-plane me-1"></i> Submit Review
          </button>
        </form>
      </div>
      <% } %>

      <!-- All Reviews Grid -->
      <div class="row g-3">
        <% if (listing.reviews && listing.reviews.length) { %>
          <% for(review of listing.reviews) { %>
          <div class="col-md-6">
            <div class="review-card">
              <div class="review-author-info">
                <div class="review-author-avatar">
                  <%= review.author && review.author.username ? review.author.username.charAt(0).toUpperCase() : 'U' %>
                </div>
                <div>
                  <div class="review-author-name">@<%= review.author ? review.author.username : 'Traveler' %></div>
                  <div class="review-date-badge">Verified Guest</div>
                </div>
              </div>

              <p
                class="starability-result card-text"
                data-rating="<%= review.rating %>"
              ></p>
              
              <p class="review-comment-body"><%= review.comment %></p>

              <% if(currUser && review.author && currUser._id.equals(review.author._id)) { %>
              <form
                class="mt-2 text-end"
                method="POST"
                action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                onsubmit="return confirm('Delete this review?');"
              >
                <button class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1">
                  <i class="fa-solid fa-trash-can me-1"></i> Delete
                </button>
              </form>
              <% } %>
            </div>
          </div>
          <% } %>
        <% } else { %>
          <div class="col-12">
            <div class="text-center py-4 bg-white rounded-4 border">
              <i class="fa-regular fa-comment text-muted fs-3 mb-2"></i>
              <p class="text-muted mb-0">No reviews yet for this listing. Be the first to leave one!</p>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Right Column: Sticky Booking Card -->
  <div class="col-lg-4">
    <div class="sticky-booking-card">
      <div class="booking-price-header">
        <div>
          <span class="booking-big-price">&#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : '0' %></span>
          <span class="booking-period">/ night</span>
        </div>
        <div class="card-rating-badge">
          <i class="fa-solid fa-star"></i>
          <span><%= listing.reviews && listing.reviews.length ? "4.95" : "New" %></span>
        </div>
      </div>

      <!-- Dummy Booking Details Pill -->
      <div class="border rounded-3 p-3 bg-light mb-3">
        <div class="row g-2 text-center text-muted small">
          <div class="col-6 border-end">
            <div class="fw-bold text-dark">CHECK-IN</div>
            <div>Select date</div>
          </div>
          <div class="col-6">
            <div class="fw-bold text-dark">CHECKOUT</div>
            <div>Select date</div>
          </div>
        </div>
      </div>

      <button class="booking-reserve-btn" onclick="alert('Booking reservation demo: This property is available for your dates!');">
        Reserve Now
      </button>
      <p class="text-center text-muted small mt-2 mb-3">You won't be charged yet</p>

      <!-- Fee Calculation Breakdown -->
      <div class="booking-fee-table">
        <div class="booking-fee-row">
          <span>&#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : '0' %> x 3 nights</span>
          <span>&#8377; <%= listing.price ? (listing.price * 3).toLocaleString("en-IN") : '0' %></span>
        </div>
        <div class="booking-fee-row">
          <span>Cleaning fee</span>
          <span>&#8377; 850</span>
        </div>
        <div class="booking-fee-row">
          <span>Wanderlust service fee</span>
          <span>&#8377; 650</span>
        </div>
        <div class="booking-fee-row">
          <span>Taxes (18% GST)</span>
          <span>&#8377; <%= listing.price ? Math.round(listing.price * 3 * 0.18).toLocaleString("en-IN") : '0' %></span>
        </div>
        <div class="booking-total-row">
          <span>Total (INR)</span>
          <span>&#8377; <%= listing.price ? ((listing.price * 3) + 850 + 650 + Math.round(listing.price * 3 * 0.18)).toLocaleString("en-IN") : '0' %></span>
        </div>
      </div>

      <!-- Trust Badges -->
      <div class="mt-4 pt-3 border-top text-muted small">
        <div class="d-flex align-items-center gap-2 mb-2">
          <i class="fa-solid fa-shield-halved text-success"></i>
          <span>Wanderlust Cover: 100% Protection on every booking</span>
        </div>
        <div class="d-flex align-items-center gap-2">
          <i class="fa-solid fa-lock text-success"></i>
          <span>Secure payments encrypted with 256-bit SSL</span>
        </div>
      </div>
    </div>
  </div>
</div>
