<% layout("/layouts/boilerplate") %>

<div class="form-page-container">
  <div class="form-card">
    <div class="form-header">
      <div class="brand-icon-wrapper mx-auto mb-3">
        <i class="fa-solid fa-gem"></i>
      </div>
      <h2 class="form-header-title">Wanderlust Your Home</h2>
      <p class="form-header-subtitle">
        Publish your sanctuary on Wanderlust and begin welcoming world travelers.
      </p>
    </div>

    <form
      method="POST"
      action="/listings"
      novalidate
      class="needs-validation"
      enctype="multipart/form-data"
    >
      <!-- Title -->
      <div class="form-group-custom">
        <label for="title" class="form-label-custom">Sanctuary Title</label>
        <input
          type="text"
          id="title"
          name="listing[title]"
          placeholder="e.g. Alpine Pine Chalet with Panoramic Views"
          class="form-control-custom"
          required
        />
        <div class="valid-feedback">Title looks great!</div>
        <div class="invalid-feedback">Please provide a descriptive title.</div>
      </div>

      <!-- Description -->
      <div class="form-group-custom">
        <label for="description" class="form-label-custom">Description</label>
        <textarea
          id="description"
          name="listing[description]"
          rows="4"
          placeholder="Describe the architectural style, views, amenities, and nearby nature trails..."
          class="form-control-custom"
          required
        ></textarea>
        <div class="invalid-feedback">Please provide a short description for your sanctuary.</div>
      </div>

      <!-- Image Upload Dropzone -->
      <div class="form-group-custom">
        <label class="form-label-custom">Cover Photo</label>
        <div class="file-upload-zone">
          <input
            type="file"
            id="image"
            name="listing[image]"
            class="file-input-hidden"
            accept="image/*"
            required
          />
          <div class="file-upload-icon">
            <i class="fa-solid fa-cloud-arrow-up"></i>
          </div>
          <div class="file-upload-text" id="fileUploadText">Click or drag photo to upload</div>
          <div class="file-upload-hint">High resolution JPG, PNG, WEBP supported</div>
        </div>
        <div id="imagePreviewBox" class="image-preview-box">
          <img id="imagePreviewImg" src="" alt="Selected Preview" />
        </div>
        <div class="invalid-feedback">Please choose an image for your sanctuary.</div>
      </div>

      <!-- Price & Country Row -->
      <div class="row g-3">
        <div class="col-md-5">
          <div class="form-group-custom">
            <label for="price" class="form-label-custom">Nightly Rate (&#8377;)</label>
            <input
              type="number"
              id="price"
              name="listing[price]"
              placeholder="3500"
              class="form-control-custom"
              min="1"
              required
            />
            <div class="invalid-feedback">Please enter a valid price.</div>
          </div>
        </div>

        <div class="col-md-7">
          <div class="form-group-custom">
            <label for="country" class="form-label-custom">Country</label>
            <input
              type="text"
              id="country"
              name="listing[country]"
              placeholder="e.g. Switzerland"
              class="form-control-custom"
              required
            />
            <div class="invalid-feedback">Please enter the country.</div>
          </div>
        </div>
      </div>

      <!-- Location -->
      <div class="form-group-custom">
        <label for="location" class="form-label-custom">Location / City</label>
        <input
          type="text"
          id="location"
          name="listing[location]"
          placeholder="e.g. Zermatt, Valais"
          class="form-control-custom"
          required
        />
        <div class="invalid-feedback">Please enter a location or region.</div>
      </div>

      <!-- Submit Button -->
      <button class="btn btn-primary-gradient mt-3 py-3" type="submit">
        <i class="fa-solid fa-circle-check me-1"></i> Publish Sanctuary
      </button>

      <div class="form-footer-note">
        You retain full control over your pricing, calendar, and house rules.
      </div>
    </form>
  </div>
</div>
