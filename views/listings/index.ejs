<% layout("/layouts/boilerplate") %>

<!-- Category & Tax Filter Bar -->
<div class="filter-bar-wrapper">
  <div class="filters-scroll-container">
    <button class="filter-pill active" data-category="all">
      <i class="fa-solid fa-fire"></i>
      <span>Trending</span>
    </button>
    <button class="filter-pill" data-category="room">
      <i class="fa-solid fa-bed"></i>
      <span>Rooms</span>
    </button>
    <button class="filter-pill" data-category="city">
      <i class="fa-solid fa-mountain-city"></i>
      <span>Iconic Cities</span>
    </button>
    <button class="filter-pill" data-category="mountain">
      <i class="fa-solid fa-mountain"></i>
      <span>Mountains</span>
    </button>
    <button class="filter-pill" data-category="castle">
      <i class="fa-brands fa-fort-awesome"></i>
      <span>Castles</span>
    </button>
    <button class="filter-pill" data-category="pool">
      <i class="fa-solid fa-person-swimming"></i>
      <span>Amazing Pools</span>
    </button>
    <button class="filter-pill" data-category="camp">
      <i class="fa-solid fa-campground"></i>
      <span>Camping</span>
    </button>
    <button class="filter-pill" data-category="farm">
      <i class="fa-solid fa-cow"></i>
      <span>Farms</span>
    </button>
    <button class="filter-pill" data-category="arctic">
      <i class="fa-regular fa-snowflake"></i>
      <span>Arctic</span>
    </button>
    <button class="filter-pill" data-category="dome">
      <i class="fa-solid fa-igloo"></i>
      <span>Domes</span>
    </button>
    <button class="filter-pill" data-category="boat">
      <i class="fa-solid fa-ship"></i>
      <span>Boats</span>
    </button>
  </div>

  <!-- Tax Switch Toggle -->
  <div class="tax-toggle-box">
    <div class="form-check form-switch mb-0">
      <input
        class="form-check-input"
        type="checkbox"
        role="switch"
        id="taxSwitchCheck"
      />
      <label class="form-check-label tax-toggle-label" for="taxSwitchCheck">
        Display total after taxes
      </label>
    </div>
  </div>
</div>

<!-- Listings Cards Grid -->
<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-3 row-cols-xl-4 g-4" id="listingsGrid">
  <% for(listing of allListings){ %>
  <div
    class="col listing-item-col"
    data-title="<%= listing.title %>"
    data-description="<%= listing.description %>"
    data-location="<%= listing.location %>"
    data-country="<%= listing.country %>"
  >
    <a href="/listings/<%= listing._id %>" class="listing-card-link">
      <div class="listing-card">
        <!-- Image & Badges -->
        <div class="card-img-container">
          <img
            src="<%= listing.image.url %>"
            alt="<%= listing.title %>"
            loading="lazy"
          />
          <button class="card-heart-btn" type="button" aria-label="Add to Wishlist">
            <i class="fa-regular fa-heart"></i>
          </button>
          <% if(listing.country) { %>
            <span class="card-badge-country"><%= listing.country %></span>
          <% } %>
        </div>

        <!-- Card Body Info -->
        <div class="card-info">
          <div class="card-title-row">
            <h5 class="card-listing-title" title="<%= listing.title %>">
              <%= listing.title %>
            </h5>
            <div class="card-rating-badge">
              <i class="fa-solid fa-star"></i>
              <span><%= listing.reviews && listing.reviews.length ? "4.9" : "New" %></span>
            </div>
          </div>

          <div class="card-listing-location">
            <i class="fa-solid fa-location-dot text-muted"></i>
            <span><%= listing.location %>, <%= listing.country %></span>
          </div>

          <div class="card-price-row">
            <span class="card-price-val">&#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : '0' %></span>
            <span class="card-price-unit">/ night</span>
            <span class="tax-badge-info">+18% GST</span>
          </div>
        </div>
      </div>
    </a>
  </div>
  <% } %>
</div>

<!-- Empty Search / Filter State -->
<div id="emptyListingState" class="empty-listings-state" style="display: none;">
  <div class="empty-state-icon">
    <i class="fa-solid fa-magnifying-glass"></i>
  </div>
  <h4 class="fw-bold mb-2">No matching listings found</h4>
  <p class="text-muted mb-3">Try adjusting your search terms or exploring all categories.</p>
  <button class="btn btn-outline-dark rounded-pill px-4" onclick="document.querySelector('[data-category=all]').click();">
    View All Listings
  </button>
</div>
