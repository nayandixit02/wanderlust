<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Welcome to Exploro</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <style>
      body {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        display: flex;
        align-items: center;
        color: #fff;
      }
      .hero-section {
        text-align: center;
      }
      .hero-title {
        font-size: 4rem;
        font-weight: bold;
        margin-bottom: 1rem;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
      }
      .hero-subtitle {
        font-size: 1.5rem;
        margin-bottom: 2rem;
        opacity: 0.9;
      }
      .cta-buttons {
        gap: 1rem;
      }
      .btn-primary {
        padding: 0.75rem 2rem;
        font-size: 1.1rem;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="hero-section">
        <h1 class="hero-title">🌍 Welcome to Exploro</h1>
        <p class="hero-subtitle">
          Discover amazing places and create unforgettable memories
        </p>
        <div class="d-flex justify-content-center cta-buttons">
          <a href="/listings" class="btn btn-light btn-lg">Explore Listings</a>
          <% if (!currUser) { %>
          <a href="/signup" class="btn btn-outline-light btn-lg">Get Started</a>
          <% } else { %>
          <a href="/listings" class="btn btn-outline-light btn-lg">View All</a>
          <% } %>
        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
