<% layout("/layouts/boilerplate") %>

<!-- Cinematic Hero Section (Matching Reference Style) -->
<section class="hero-cinematic">
  <div class="hero-cinematic-overlay"></div>
  <div class="hero-cinematic-content">
    <h1 class="hero-cinematic-title">
      Unearth Extraordinary Escapes
    </h1>
    <p class="hero-cinematic-subtitle">
      Handpicked sanctuaries and immersive journeys crafted for the mindful explorer.
    </p>

    <!-- 4-Part Glassmorphic Floating Search Box -->
    <form class="hero-glass-searchbar" action="/listings" method="GET">
      <!-- 1. Where to? -->
      <div class="search-field-pill">
        <i class="fa-solid fa-location-dot"></i>
        <input
          type="text"
          name="q"
          placeholder="Where to? (e.g. Goa, Alps, Bali)"
          required
        />
      </div>

      <!-- 2. Check in - Check out -->
      <div class="search-field-pill">
        <i class="fa-regular fa-calendar"></i>
        <input
          type="text"
          placeholder="Check in - Check out"
          onfocus="(this.type='date')"
          onblur="(this.type='text')"
        />
      </div>

      <!-- 3. Guests -->
      <div class="search-field-pill">
        <i class="fa-solid fa-user-group"></i>
        <input
          type="text"
          placeholder="Guests (e.g. 2 Guests)"
        />
      </div>

      <!-- 4. Search Button -->
      <button type="submit" class="search-btn-gradient">
        <i class="fa-solid fa-magnifying-glass"></i>
        <span>Search</span>
      </button>
    </form>
  </div>
</section>

<!-- Inspiring Collections / Categories -->
<section class="mb-5">
  <div class="section-header text-center text-md-start">
    <span class="section-tag">Curated Collections</span>
    <h2 class="section-title">Explore by Style of Stay</h2>
    <p class="section-subtitle">Discover handcrafted spaces designed for every kind of travel experience</p>
  </div>

  <div class="row row-cols-2 row-cols-md-3 row-cols-lg-6 g-3">
    <div class="col">
      <a href="/listings?category=city" class="category-card">
        <div class="category-icon-box">
          <i class="fa-solid fa-mountain-city"></i>
        </div>
        <h6 class="category-name">Iconic Cities</h6>
        <span class="category-count">Urban sanctuaries</span>
      </a>
    </div>

    <div class="col">
      <a href="/listings?category=beach" class="category-card">
        <div class="category-icon-box">
          <i class="fa-solid fa-umbrella-beach"></i>
        </div>
        <h6 class="category-name">Coastal Villas</h6>
        <span class="category-count">Ocean views</span>
      </a>
    </div>

    <div class="col">
      <a href="/listings?category=mountain" class="category-card">
        <div class="category-icon-box">
          <i class="fa-solid fa-mountain"></i>
        </div>
        <h6 class="category-name">Alpine Cabins</h6>
        <span class="category-count">High-altitude escapes</span>
      </a>
    </div>

    <div class="col">
      <a href="/listings?category=pool" class="category-card">
        <div class="category-icon-box">
          <i class="fa-solid fa-person-swimming"></i>
        </div>
        <h6 class="category-name">Amazing Pools</h6>
        <span class="category-count">Private luxury</span>
      </a>
    </div>

    <div class="col">
      <a href="/listings?category=castle" class="category-card">
        <div class="category-icon-box">
          <i class="fa-brands fa-fort-awesome"></i>
        </div>
        <h6 class="category-name">Historic Estates</h6>
        <span class="category-count">Timeless grandeur</span>
      </a>
    </div>

    <div class="col">
      <a href="/listings?category=camp" class="category-card">
        <div class="category-icon-box">
          <i class="fa-solid fa-campground"></i>
        </div>
        <h6 class="category-name">Glamping Stays</h6>
        <span class="category-count">Nature retreats</span>
      </a>
    </div>
  </div>
</section>

<!-- The Wanderlust Difference -->
<section class="my-5 py-4">
  <div class="section-header text-center">
    <span class="section-tag">The Wanderlust Standard</span>
    <h2 class="section-title">Designed for Unrivaled Peace of Mind</h2>
    <p class="section-subtitle">Every stay is backed by our authentic quality commitment and guest care</p>
  </div>

  <div class="row g-4 mt-2">
    <div class="col-md-6 col-lg-3">
      <div class="feature-card">
        <div class="feature-icon-bubble">
          <i class="fa-solid fa-shield-halved"></i>
        </div>
        <h5 class="feature-title">Verified Sanctuaries</h5>
        <p class="feature-desc">
          Rigorous quality inspections guarantee cleanliness, comfort, high-speed Wi-Fi, and authentic amenities.
        </p>
      </div>
    </div>

    <div class="col-md-6 col-lg-3">
      <div class="feature-card">
        <div class="feature-icon-bubble">
          <i class="fa-solid fa-receipt"></i>
        </div>
        <h5 class="feature-title">Transparent Pricing</h5>
        <p class="feature-desc">
          Direct rates with upfront tax calculation. No hidden service markups or check-out surprises.
        </p>
      </div>
    </div>

    <div class="col-md-6 col-lg-3">
      <div class="feature-card">
        <div class="feature-icon-bubble">
          <i class="fa-solid fa-headset"></i>
        </div>
        <h5 class="feature-title">24/7 Guest Care</h5>
        <p class="feature-desc">
          Dedicated concierge assistance around the clock for reservations, itinerary changes, and on-ground support.
        </p>
      </div>
    </div>

    <div class="col-md-6 col-lg-3">
      <div class="feature-card">
        <div class="feature-icon-bubble">
          <i class="fa-solid fa-medal"></i>
        </div>
        <h5 class="feature-title">Superhost Network</h5>
        <p class="feature-desc">
          Accommodations hosted by verified local hosts recognized for outstanding hospitality and local wisdom.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- Wanderlust Your Home - Host CTA Banner -->
<section class="host-cta-banner">
  <div class="row align-items-center position-relative" style="z-index: 2;">
    <div class="col-lg-8">
      <span class="badge bg-primary px-3 py-2 rounded-pill fw-bold text-white mb-3">Host Community</span>
      <h3 class="host-cta-title">Wanderlust your home and earn seamlessly</h3>
      <p class="host-cta-desc">
        Share your unique villa, loft, or sanctuary with travelers from around the world. Enjoy full insurance coverage, flexible calendar controls, and top earnings.
      </p>
    </div>
    <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
      <a href="/listings/new" class="host-cta-btn">
        <i class="fa-solid fa-plus"></i> List Your Sanctuary
      </a>
    </div>
  </div>
</section>
