# Server Configuration
PORT=8080
NODE_ENV=production
SECRET=your_super_secret_session_key

# Database Configuration (Docker Compose default uses 'mongo' host)
ATLASDB_URL=mongodb://mongo:27017/exploro

# Cloudinary Storage Configuration (Optional for cloud media uploads)
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret
